{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.pjecalc.local/schemas/especificacao-calculo/1.0",
  "title": "Especificação de Cálculo Trabalhista",
  "description": "Modelo de domínio próprio, independente das telas e classes do PJe-Calc. Ver docs/06-api/especificacao-de-calculo.md. Rascunho v1.0 — será ampliado na Fase 2 do roadmap.",
  "type": "object",
  "required": ["versaoEspecificacao", "processo", "contrato"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "properties": {
    "versaoEspecificacao": { "const": "1.0" },
    "processo": {
      "type": "object",
      "required": ["regional"],
      "additionalProperties": false,
      "properties": {
        "numero": { "type": "string", "pattern": "^\\d{7}-\\d{2}\\.\\d{4}\\.5\\.\\d{2}\\.\\d{4}$", "description": "Número CNJ (segmento 5 = Justiça do Trabalho)" },
        "regional": { "$ref": "#/$defs/regional" },
        "vara": { "type": "string" },
        "manual": { "type": "boolean", "default": false }
      }
    },
    "partes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reclamante": { "$ref": "#/$defs/parte" },
        "reclamado": { "$ref": "#/$defs/parte" },
        "advogados": { "type": "array", "items": { "$ref": "#/$defs/advogado" } }
      }
    },
    "contrato": {
      "type": "object",
      "required": ["admissao", "ajuizamento"],
      "additionalProperties": false,
      "properties": {
        "admissao": { "$ref": "#/$defs/data" },
        "demissao": { "$ref": "#/$defs/data" },
        "ajuizamento": { "$ref": "#/$defs/data" },
        "tipoRescisao": { "enum": ["sem_justa_causa", "justa_causa", "pedido_demissao", "rescisao_indireta", "acordo_484A", "termino_contrato", "vigente"] },
        "regime": { "enum": ["tempo_integral", "tempo_parcial", "intermitente"], "default": "tempo_integral" },
        "avisoPrevio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tipo": { "enum": ["indenizado", "trabalhado", "nao_ha"] },
            "projetar": { "type": "boolean", "description": "Projetar o aviso indenizado no tempo de serviço" },
            "dias": { "type": "integer", "minimum": 30, "maximum": 90, "description": "Omitido = calculado pela Lei 12.506/2011" }
          }
        },
        "ultimaRemuneracao": { "$ref": "#/$defs/dinheiro" }
      }
    },
    "parametros": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uf": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "municipio": { "type": "string" },
        "periodoCalculo": { "$ref": "#/$defs/periodo" },
        "cargaHorariaMensal": { "$ref": "#/$defs/decimal", "default": "220" },
        "sabadoDiaUtil": { "type": "boolean", "default": true },
        "feriadoEstadual": { "type": "boolean", "default": true },
        "feriadoMunicipal": { "type": "boolean", "default": true },
        "prescricao": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quinquenal": { "type": "boolean", "default": true, "description": "Padrão da especificação: aplicar. No PJe-Calc a opção vem desmarcada; o adaptador sempre envia o valor explícito." },
            "fgtsTrintenaria": { "type": "boolean", "default": false }
          }
        },
        "maiorRemuneracao": { "$ref": "#/$defs/dinheiro" },
        "zerarValoresNegativos": { "type": "boolean", "default": false },
        "limitarAvosAoPeriodo": { "type": "boolean", "default": false }
      }
    },
    "historicoSalarial": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nome", "periodos"],
        "additionalProperties": false,
        "properties": {
          "nome": { "type": "string", "examples": ["Salário base", "Comissões"] },
          "incidencias": { "$ref": "#/$defs/incidencias" },
          "periodos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["de", "ate", "valor"],
              "additionalProperties": false,
              "properties": {
                "de": { "$ref": "#/$defs/competencia" },
                "ate": { "$ref": "#/$defs/competencia" },
                "valor": { "$ref": "#/$defs/dinheiro" },
                "fgtsRecolhido": { "type": "boolean" },
                "inssRecolhido": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "faltas": {
      "type": "array",
      "items": {
        "type": "object", "required": ["inicio", "fim"], "additionalProperties": false,
        "properties": { "inicio": { "$ref": "#/$defs/data" }, "fim": { "$ref": "#/$defs/data" }, "justificada": { "type": "boolean", "default": false }, "motivo": { "type": "string" } }
      }
    },
    "ferias": {
      "type": "array",
      "items": {
        "type": "object", "required": ["aquisitivo"], "additionalProperties": false,
        "properties": {
          "aquisitivo": { "$ref": "#/$defs/periodo" },
          "situacao": { "enum": ["gozadas", "indenizadas", "gozadas_parcialmente", "perdidas"] },
          "gozos": { "type": "array", "items": { "$ref": "#/$defs/periodo" } },
          "abonoPecuniario": { "type": "boolean", "default": false },
          "dobra": { "type": "boolean", "default": false }
        }
      }
    },
    "cartaoDePonto": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "required": ["modo"], "additionalProperties": false,
          "properties": {
            "modo": { "enum": ["quantidades", "jornadas"] },
            "colunas": { "type": "array", "maxItems": 15, "items": { "type": "string" }, "description": "Nomes das colunas (modo quantidades)" },
            "linhas": { "type": "array", "items": { "type": "object" }, "description": "Competência + quantidades, ou dia + horários. Detalhado na Fase 2." }
          }
        }
      ]
    },
    "verbas": { "type": "array", "items": { "$ref": "#/$defs/verba" } },
    "fgts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "aliquota": { "$ref": "#/$defs/decimal", "default": "8" },
        "destino": { "enum": ["pagar", "recolher"], "default": "recolher", "description": "Pagar ao reclamante ou recolher em conta vinculada" },
        "multa": { "enum": ["40", "20", "nao_ha"], "default": "40" },
        "baseDaMulta": {
          "enum": ["devido", "diferenca", "saldo_saque", "devido_mais_saldo_saque", "devido_menos_saldo_saque"],
          "default": "devido",
          "description": "Sobre o que a multa incide: FGTS devido, diferença (devido − depositado), saldo e/ou saque, ou combinações"
        },
        "deduzirDepositados": { "type": "boolean", "default": true },
        "comporPrincipal": { "type": "boolean" }
      }
    },
    "contribuicaoSocial": { "type": "object", "description": "INSS: salários devidos/pagos, atividade econômica, cota do empregador. Detalhado na Fase 2." },
    "impostoDeRenda": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "apurar": { "type": "boolean", "default": true },
        "dependentes": { "type": "integer", "minimum": 0 },
        "tributacaoExclusiva13": { "type": "boolean" },
        "tributacaoSeparadaFerias": { "type": "boolean" },
        "incidirSobreJuros": { "type": "boolean", "default": false }
      }
    },
    "honorarios": {
      "type": "array",
      "items": {
        "type": "object", "required": ["devedor", "percentual"], "additionalProperties": false,
        "properties": {
          "devedor": { "enum": ["reclamado", "reclamante"] },
          "credor": { "type": "string" },
          "percentual": { "$ref": "#/$defs/decimal" },
          "base": { "enum": ["bruto", "liquido", "verbas_selecionadas", "valor_informado"], "default": "bruto" },
          "valorInformado": { "$ref": "#/$defs/dinheiro" }
        }
      }
    },
    "multas": { "type": "array", "items": { "type": "object" }, "description": "Multas e indenizações (art. 467, 477, multa normativa...). Detalhado na Fase 2." },
    "custas": { "type": "object", "description": "Custas de conhecimento, liquidação, fixas. Detalhado na Fase 2." },
    "correcaoJurosMulta": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "combinacao": {
          "type": "array",
          "description": "Índices e juros por período (ex.: IPCA-E na fase pré-judicial e SELIC/taxa legal após o ajuizamento — ADC 58/59 e Lei 14.905/2024).",
          "items": {
            "type": "object", "required": ["aPartirDe", "indice"], "additionalProperties": false,
            "properties": {
              "aPartirDe": { "$ref": "#/$defs/data" },
              "indice": { "type": "string", "description": "Valor de GET /v1/catalogos/indices-correcao (ex.: IPCAE, SELIC)" },
              "juros": { "type": "string", "description": "Valor de GET /v1/catalogos/juros (ex.: TAXA_LEGAL, SEM_JUROS)" }
            }
          }
        },
        "indicesAcumulados": { "enum": ["MES_SUBSEQUENTE_AO_VENCIMENTO", "MES_DO_VENCIMENTO", "MES_SUBSEQUENTE_E_MES_DO_VENCIMENTO"] }
      }
    },
    "anotacoes": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "premissas": { "type": "array", "items": { "type": "string" } },
        "fontes": { "type": "array", "items": { "type": "object", "required": ["campo"], "properties": { "campo": { "type": "string", "description": "JSON Pointer" }, "documento": { "type": "string" }, "pagina": { "type": "string" } } } }
      }
    }
  },
  "$defs": {
    "data": { "type": "string", "format": "date" },
    "competencia": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "decimal": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
    "dinheiro": { "type": "string", "pattern": "^-?\\d+(\\.\\d{1,2})?$" },
    "regional": { "type": "string", "pattern": "^TRT([1-9]|1\\d|2[0-4])$" },
    "periodo": {
      "type": "object", "required": ["inicio", "fim"], "additionalProperties": false,
      "properties": { "inicio": { "$ref": "#/$defs/data" }, "fim": { "$ref": "#/$defs/data" } }
    },
    "incidencias": {
      "type": "object", "additionalProperties": false,
      "properties": { "fgts": { "type": "boolean" }, "inss": { "type": "boolean" }, "irpf": { "type": "boolean" }, "previdenciaPrivada": { "type": "boolean" }, "pensaoAlimenticia": { "type": "boolean" } }
    },
    "parte": {
      "type": "object", "required": ["nome"], "additionalProperties": false,
      "properties": {
        "nome": { "type": "string" },
        "cpf": { "type": "string", "pattern": "^\\d{11}$" },
        "cnpj": { "type": "string", "pattern": "^\\d{14}$" },
        "pisPasepNit": { "type": "string" }
      }
    },
    "advogado": {
      "type": "object", "required": ["nome"], "additionalProperties": false,
      "properties": { "nome": { "type": "string" }, "oab": { "type": "string" }, "representa": { "enum": ["reclamante", "reclamado"] } }
    },
    "verba": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "oneOf": [ { "required": ["catalogo"] }, { "required": ["personalizada"] } ],
      "properties": {
        "catalogo": { "type": "string", "description": "Nome da verba na biblioteca do motor (GET /v1/catalogos/verbas)" },
        "personalizada": { "type": "object", "description": "Verba manual: nome, característica, ocorrência de pagamento, incidências. Detalhado na Fase 2." },
        "descricao": { "type": "string" },
        "periodo": { "$ref": "#/$defs/periodo" },
        "base": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "tipo": { "enum": ["historico_salarial", "maior_remuneracao", "salario_minimo", "piso_categoria", "verbas", "valor_informado"] },
            "historicos": { "type": "array", "items": { "type": "string" } },
            "valor": { "$ref": "#/$defs/dinheiro" }
          }
        },
        "divisor": { "type": "object", "properties": { "tipo": { "enum": ["carga_horaria", "dias_uteis", "informado", "cartao_de_ponto"] }, "valor": { "$ref": "#/$defs/decimal" } } },
        "multiplicador": { "$ref": "#/$defs/decimal" },
        "quantidade": { "type": "object", "properties": { "tipo": { "enum": ["informada", "calendario", "cartao_de_ponto"] }, "valor": { "$ref": "#/$defs/decimal" }, "coluna": { "type": "string" } } },
        "valorPago": { "type": "object", "description": "Valores já pagos a deduzir (diferenças)" },
        "incidencias": { "$ref": "#/$defs/incidencias" },
        "ocorrencias": { "type": "array", "items": { "type": "object" }, "description": "Ajustes mês a mês (competência, quantidade, devido, pago)" },
        "reflexos": {
          "type": "array",
          "items": {
            "type": "object", "required": ["catalogo"], "additionalProperties": false,
            "properties": {
              "catalogo": { "type": "string", "examples": ["REPOUSO SEMANAL REMUNERADO E FERIADO", "13º SALÁRIO", "FÉRIAS + 1/3", "AVISO PRÉVIO"] },
              "comportamento": { "type": "string" },
              "incidencias": { "$ref": "#/$defs/incidencias" }
            }
          }
        }
      }
    }
  }
}
